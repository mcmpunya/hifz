generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Per-verse memorization state with a lightweight spaced-repetition schedule
model VerseProgress {
  id             String    @id @default(cuid())
  surah          Int // 1..114
  verse          Int // 1..
  status         String    @default("learning") // learning | memorized
  repetitions    Int       @default(0) // successful reviews in a row
  intervalDays   Int       @default(0) // current SRS interval
  ease           String    @default("normal") // normal | hard | easy (last rating)
  lapses         Int       @default(0) // times forgotten while memorized
  nextReviewAt   DateTime? // due date for review
  lastReviewedAt DateTime?
  memorizedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([surah, verse])
  @@index([status])
  @@index([nextReviewAt])
}

// Daily activity for streak + charts
model ActivityLog {
  id        String @id @default(cuid())
  date      String @unique // yyyy-mm-dd
  memorized Int    @default(0)
  reviewed  Int    @default(0)
  minutes   Int    @default(0)
}
